rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection - role-based access control
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Admins can read all user profiles
      allow read: if isAdmin();
      // Users can update their own profile (except role)
      allow write: if isOwner(userId) && 
                     request.resource.data.keys().hasAll(['email', 'displayName']) &&
                     !request.resource.data.keys().contains('role');
      // Only admins can write to user documents and set roles
      allow write: if isAdmin();
      // Users can create their own profile on sign-up
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['email', 'displayName', 'role']) &&
                       request.resource.data.role == 'student';
    }
    
    // Books collection - admin management with public read access
    match /books/{bookId} {
      // All authenticated users can read books
      allow read: if request.auth != null;
      // Only admins can create, update, or delete books
      allow write: if isAdmin();
    }
    
    // Classes collection - teacher and admin management
    match /classes/{classId} {
      // All authenticated users can read class information
      allow read: if request.auth != null;
      // Only admins can create classes
      allow create: if isAdmin();
      // Class teachers and admins can update classes
      allow update: if isAdmin() || 
                       resource.data.teacherId == request.auth.uid;
      // Only admins can delete classes
      allow delete: if isAdmin();
    }
    
    // Enrollments collection - student self-enrollment and teacher management
    match /enrollments/{enrollmentId} {
      // Users can read their own enrollments
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId ||
                      isAdmin() ||
                      get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid);
      // Students can create their own enrollments
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.studentId;
      // Students can delete their own enrollments
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.studentId;
      // Teachers can manage enrollments for their classes
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid;
      // Admins can manage all enrollments
      allow write: if isAdmin();
    }
    
    // User shelf entries - personal book tracking
    match /userShelfEntries/{userId} {
      // Users can read their own shelf entries
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users can create and update their own shelf entries
      allow write: if request.auth != null && request.auth.uid == userId;
      // Admins can read all shelf entries for oversight
      allow read: if isAdmin();
    }
  }
}