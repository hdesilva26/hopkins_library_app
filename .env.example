# Firebase Configuration
# Copy this file to .env and fill in your actual values
# Use these with --dart-define when building the app

# Platform-specific API Keys
ANDROID_FIREBASE_API_KEY=your_android_api_key_here
IOS_FIREBASE_API_KEY=your_ios_api_key_here
MACOS_FIREBASE_API_KEY=your_macos_api_key_here
WINDOWS_FIREBASE_API_KEY=your_windows_api_key_here

# Platform-specific App IDs
ANDROID_FIREBASE_APP_ID=your_android_app_id_here
IOS_FIREBASE_APP_ID=your_ios_app_id_here
MACOS_FIREBASE_APP_ID=your_macos_app_id_here
WINDOWS_FIREBASE_APP_ID=your_windows_app_id_here

# Shared Firebase Configuration
FIREBASE_PROJECT_ID=hopkins-summer-reading
FIREBASE_MESSAGING_SENDER_ID=627822257528
FIREBASE_STORAGE_BUCKET=hopkins-summer-reading.firebasestorage.app
FIREBASE_AUTH_DOMAIN=hopkins-summer-reading.firebaseapp.com
FIREBASE_MEASUREMENT_ID=G-FRL2S3SCGZ

# Platform-specific Bundle IDs
IOS_BUNDLE_ID=com.example.libraryApp

# Build Example:
# flutter run --dart-define=ANDROID_FIREBASE_API_KEY=your_key_here